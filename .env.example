# URL del backend (Railway).
# En desarrollo: http://localhost:3000
# En producción (Vercel): https://MediHistory-back.up.railway.app
VITE_API_URL=https://MediHistory-back.up.railway.app

# reCAPTCHA v2 (casilla "No soy un robot" en el registro).
# Por defecto: test key pública de Google (valida siempre en no-producción).
VITE_RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI

# Public key de MercadoPago (sección "Credenciales" de la aplicación en el
# dashboard de MercadoPago). NO es secreta (a diferencia de
# MERCADOPAGO_ACCESS_TOKEN, exclusivo del backend): se usa en el navegador
# para inicializar el SDK (initMercadoPago) que renderiza el formulario de
# tarjeta (Checkout Bricks / <CardPayment>) en /elegir-plan. Si falta, el
# modal de pago muestra un error explícito en vez de un formulario roto.
VITE_MERCADOPAGO_PUBLIC_KEY=
